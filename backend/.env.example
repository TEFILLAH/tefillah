# MongoDB
MONGO_URL=mongodb://localhost:27017
DB_NAME=tefilah

# JWT Configuration
JWT_SECRET=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_DAYS=7

# Admin Secret (for creating first admin)
ADMIN_SECRET=tefilah-admin-secret-2024

# LLM Configuration — choose provider: gemini (recommended) | openrouter | ollama
LLM_PROVIDER=gemini

# Google Gemini (recommended — free tier, fast, multilingual)
# Get API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Local Ollama (fallback)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:8b

# Email Configuration (Resend)
RESEND_API_KEY=
SENDER_EMAIL=admin@tefillah.in

# Firebase Configuration (for Google sign-in)
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=

# Sign in with Apple — the accepted `aud` values for Apple identity tokens.
# NOT secrets: these are public identifiers, and they are already set on the
# production Elastic Beanstalk environment.
#
# verify_apple_token() FAILS CLOSED when both are empty — it refuses every
# Apple token rather than accepting any audience. So a local backend with these
# unset returns 401 for every Apple sign-in, which looks exactly like a bad
# token. Set them if you are testing the Apple flow locally.
#
# Note the single L in `tefilah` (the bundle id) versus the double L in the
# `tefillah.in` domain — a typo here fails closed and is indistinguishable from
# a broken token.
APPLE_BUNDLE_ID=com.tefilah.app
# Only needed if the WEB Apple flow is enabled (tefillah-web APPLE_SIGNIN_ENABLED).
APPLE_SERVICE_ID=com.tefilah.app.web

# Sign in with Apple — REVOCATION key material (App Store guideline 5.1.1(v):
# deleting an account must also revoke the user's Apple token).
#
# Unlike verification above, these fail SOFT: with them unset, account deletion
# still works exactly as before and logs "Apple revocation SKIPPED". Nothing
# else breaks — but Apple review can reject the app for it, so set them in prod.
APPLE_TEAM_ID=KY52RZ3ZFK
APPLE_KEY_ID=D72A2BMF4H
# SECRET. The full contents of the AuthKey_<KEY_ID>.p8 downloaded ONCE from
# developer.apple.com (Certificates > Keys). Never commit it, never log it.
# Env stores cannot hold real newlines, so paste it with literal \n escapes:
#   APPLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIGT...\n-----END PRIVATE KEY-----\n
APPLE_PRIVATE_KEY=

# OpenRouter API (legacy fallback, optional)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324

# CORS - comma-separated allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:19006

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
