{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageTefillahTables",
      "Effect": "Allow",
      "Action": [
        "dynamodb:CreateTable",
        "dynamodb:DeleteTable",
        "dynamodb:DescribeTable",
        "dynamodb:UpdateTable",
        "dynamodb:DescribeTimeToLive",
        "dynamodb:UpdateTimeToLive",
        "dynamodb:UpdateContinuousBackups",
        "dynamodb:DescribeContinuousBackups",
        "dynamodb:TagResource",
        "dynamodb:ListTagsOfResource"
      ],
      "Resource": [
        "arn:aws:dynamodb:ap-south-1:020262236044:table/tefillah_*",
        "arn:aws:dynamodb:ap-south-1:020262236044:table/tefillah_*/index/*"
      ]
    },
    {
      "Sid": "BackfillAndVerifyData",
      "Effect": "Allow",
      "Action": [
        "dynamodb:PutItem",
        "dynamodb:BatchWriteItem",
        "dynamodb:GetItem",
        "dynamodb:BatchGetItem",
        "dynamodb:Query",
        "dynamodb:Scan",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "dynamodb:DescribeTable"
      ],
      "Resource": [
        "arn:aws:dynamodb:ap-south-1:020262236044:table/tefillah_*",
        "arn:aws:dynamodb:ap-south-1:020262236044:table/tefillah_*/index/*"
      ]
    },
    {
      "Sid": "ListTablesIsAccountWideOnly",
      "Effect": "Allow",
      "Action": ["dynamodb:ListTables"],
      "Resource": "*"
    }
  ]
}
