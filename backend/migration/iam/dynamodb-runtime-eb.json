{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TefillahAppRuntimeDataAccess",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:BatchGetItem",
        "dynamodb:Query",
        "dynamodb:Scan",
        "dynamodb:PutItem",
        "dynamodb:BatchWriteItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "dynamodb:ConditionCheckItem",
        "dynamodb:DescribeTable"
      ],
      "Resource": [
        "arn:aws:dynamodb:ap-south-1:020262236044:table/tefillah_*",
        "arn:aws:dynamodb:ap-south-1:020262236044:table/tefillah_*/index/*"
      ]
    }
  ]
}
